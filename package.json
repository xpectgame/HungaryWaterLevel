{
  "name": "hungary-water-level",
  "version": "0.1.0",
  "description": "REST API for Hungary's real-time surface water balance and power-sector cooling water use",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "poll": "node src/jobs/poll.js --once",
    "backfill": "node src/jobs/poll.js --backfill",
    "test": "node --test \"test/*.test.js\"",
    "probe": "node src/jobs/probe.js",
    "probe:save": "bash scripts/probe-save.sh"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.22.0"
  },
  "license": "MIT",
  "private": true
}
