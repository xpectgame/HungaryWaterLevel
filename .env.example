# ---------------------------------------------------------------------------
# HungaryWaterLevel configuration
# Copy to .env and adjust. Every value here has a working default.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 'fixture' = synthetic data, runs offline, safe for development.
# 'live'    = data.vizugy.hu + MAVIR. Requires the endpoint settings below to be
#             confirmed first - see README, "Before going live".
# Defaults to fixture in development and live in production. Starting in production
# with fixture data is refused unless ALLOW_FIXTURE_IN_PRODUCTION=true.
DATA_PROVIDER=fixture
# ALLOW_FIXTURE_IN_PRODUCTION=false

# Stateless mode: memory store + on-demand refresh instead of SQLite + background
# poller. Auto-enabled on Vercel (VERCEL=1); set explicitly to force either way.
# STATELESS=false
# STORE=sqlite            # sqlite | memory
# BACKGROUND_POLLING=true
# LAZY_REFRESH=false
# MEMORY_MAX_SAMPLES=500

DB_PATH=./data/hungarywaterlevel.db

# Postgres: shared storage for serverless. Its presence switches STORE to postgres.
# Use the provider's POOLED connection string (Neon's -pooler host, Supabase port 6543)
# - serverless scales horizontally and will otherwise exhaust the connection limit.
# DATABASE_URL=postgres://user:pass@host/db
# DATABASE_SCHEMA=              # optional: keep tables in their own schema

# Shared secret for the cron endpoint. Vercel sends it as `Authorization: Bearer`.
# Without it the cron endpoint refuses to run in production.
# CRON_SECRET=

# MAVIR publishes every 15 minutes; polling faster only adds load.
POLL_INTERVAL_MS=900000
POLL_ON_START=true

# Past this age a gauge stops counting as live and the balance falls back to its
# long-term mean, flagged in the response. 24 h, matching the window the adapter
# asks for: the network reports unevenly, and a stale measurement beats a decade's
# average - in a drought the average is wrong by a factor of five to twenty.
MAX_READING_AGE_MS=86400000

# Must exceed the longest travel time in the station registry (~200 h) for the
# lagged balance to have history to read.
RETENTION_DAYS=400

DEFAULT_BALANCE_METHOD=instant   # instant | lagged
DEFAULT_COOLING_MODEL=linear     # linear | thermal | units

# ENTSO-E Transparency Platform: per-unit outages, which is what tells the 'units'
# cooling model how many units are actually running rather than making it infer a
# lower bound from output. Free: register on the platform, then email
# transparency@entsoe.eu asking for API access.
# Without a token the units model still works, labelled as an inference.
# ENTSOE_TOKEN=
# ENTSOE_DOMAIN=10YHU-MAVIR----U
# ENTSOE_DOCUMENT_TYPE=A80

CACHE_TTL_MS=60000
CORS_ORIGIN=*
SERVE_FRONTEND=true

# ---------------------------------------------------------------------------
# Upstream endpoints
#
# UNVERIFIED. Both services were unreachable from the environment this project was
# built in, so these are placeholders, not confirmed contracts. Run
# `npm run probe` from a machine that can reach them and set what actually works.
# ---------------------------------------------------------------------------

# VIZUGY_BASE_URL=https://data.vizugy.hu
# VIZUGY_PATH=/api/stations/{externalId}/discharge/latest
# VIZUGY_ARRAY_PATH=data
# VIZUGY_VALUE_FIELD=value
# VIZUGY_TIME_FIELD=timestamp
# VIZUGY_API_KEY=
# VIZUGY_TIMEOUT_MS=15000

# MAVIR_BASE_URL=https://www.mavir.hu
# MAVIR_PATH=/rtdwweb/webuser/chart/{chartId}/data
# MAVIR_CHART_ID=7678
# MAVIR_ARRAY_PATH=data
# MAVIR_TIME_FIELD=timestamp
# MAVIR_TIMEOUT_MS=20000
